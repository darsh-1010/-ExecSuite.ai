# AgenticOrg API Key Configuration
# Copy this file to .env and fill in the keys you want to use.

# Primary: Google AI Studio (Gemini 2.5 Flash / Pro)
GEMINI_API_KEY=

# Option 2: Groq (Llama 3, Gemma 2, etc.)
GROQ_API_KEY=

# Option 3: OpenRouter (Free models)
OPENROUTER_API_KEY=

# Option 4: Cohere
COHERE_API_KEY=

# Option 5: OpenAI
OPENAI_API_KEY=

# Optional: Host and Port settings
PORT=8000
HOST=127.0.0.1
